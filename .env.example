# Postgres. Use the POOLED connection string in DATABASE_URL (Neon: the "-pooler" host).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Database tests (npm run test:int / test:e2e) refuse to run without a SEPARATE,
# disposable database here; they create and delete rows. See docker-compose.yml.
TEST_DATABASE_URL=

# `next dev` pushes schema changes straight to DATABASE_URL only when this is
# "true". Everywhere else the schema comes from src/migrations.
ALLOW_SCHEMA_PUSH=

# Payload cookie/JWT signing secret. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Cloudflare R2. Uploads fall back to local disk until all four are set.
# R2_ACCOUNT_ID is the Cloudflare account id, not the bucket name.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for serving files: a custom domain on the bucket, or the r2.dev subdomain.
R2_PUBLIC_URL=

# Public origin of the storefront, no trailing slash. Used in email links and
# as the base of the Google redirect URI.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID, type "Web application"). Authorised redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
# The "Continue with Google" button is hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Texted sign-in codes. `console` (the development default) prints the code to
# the terminal; `msg91` sends it, and needs DLT registration first. With no
# provider in production, mobile sign-in is hidden and Google signs people in
# without asking for a number.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay (Dashboard → Account & Settings → API Keys). Checkout's Pay button
# stays off until both keys are set. Use rzp_test_ keys until you go live, and
# turn on automatic payment capture (Account & Settings → Payment capture).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: <NEXT_PUBLIC_SITE_URL>/api/webhooks/razorpay,
# events payment.captured and order.paid, with this as the secret.
RAZORPAY_WEBHOOK_SECRET=

# Order emails through Resend (resend.com → API Keys). The from address must be
# on a domain verified in Resend. Unset, emails print to the terminal in development.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tools Hypermarket
# Comma-separated staff addresses that get a "new order" email.
ORDER_ALERT_EMAILS=

# Scheduled jobs (abandoned carts, expiring unpaid orders) require
# Authorization: Bearer <CRON_SECRET>. Vercel Cron sends it. 16+ characters.
CRON_SECRET=
