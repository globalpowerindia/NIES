# Postgres. Use the POOLED connection string in DATABASE_URL (Neon: the "-pooler" host).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Payload cookie/JWT signing secret. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Cloudflare R2. Uploads fall back to local disk until all four are set.
# R2_ACCOUNT_ID is the Cloudflare account id, not the bucket name.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for serving files: a custom domain on the bucket, or the r2.dev subdomain.
R2_PUBLIC_URL=
