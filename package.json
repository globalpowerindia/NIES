{
  "name": "powertools-commerce",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:unit && npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project int",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project unit",
    "media:repair": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/repair-media.ts",
    "search:check": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/search-check.ts",
    "search:reindex": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/reindex-search.ts",
    "import:catalogue": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/import-catalogue.ts",
    "seed:orders": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/orders.ts",
    "seed:pages": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/pages.ts",
    "seed:storefront": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/storefront.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db:migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env tests/helpers/migrate-test-db.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-resend": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "overrides": {
    "payload": {
      "undici": "7.29.1"
    }
  }
}
